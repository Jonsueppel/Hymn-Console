{
  "name": "hymn-console",
  "version": "2.2.0",
  "private": true,
  "description": "Raspberry Pi friendly church hymn library and hymn console.",
  "homepage": "https://github.com/Jonsueppel/Hymn-Console#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonsueppel/Hymn-Console.git"
  },
  "bugs": {
    "url": "https://github.com/Jonsueppel/Hymn-Console/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "raspberry-pi",
    "church",
    "hymns",
    "music",
    "airplay",
    "sqlite",
    "service-planning"
  ],
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check public/app.js && node --check lib/storage.js && node --check lib/auth.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:soak": "node scripts/soak-test.js"
  },
  "engines": {
    "node": ">=24"
  }
}
